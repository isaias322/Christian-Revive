<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_courier_list" model="ir.ui.view">
        <field name="name">marketplace.courier.list</field>
        <field name="model">marketplace.courier</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="supports_cod"/>
                <field name="flat_rate"/>
                <field name="tracking_url_pattern"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_marketplace_couriers" model="ir.actions.act_window">
        <field name="name">Couriers</field>
        <field name="res_model">marketplace.courier</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
