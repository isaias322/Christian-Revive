<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="public_category_furniture" model="product.public.category">
        <field name="name">Furniture &amp; Home</field>
        <field name="sequence">10</field>
    </record>
    <record id="public_category_fruits_veg" model="product.public.category">
        <field name="name">Fruits &amp; Vegetables</field>
        <field name="sequence">20</field>
    </record>
    <record id="public_category_pantry" model="product.public.category">
        <field name="name">Healthy Pantry</field>
        <field name="sequence">30</field>
    </record>

    <record id="menu_shop_furniture" model="website.menu">
        <field name="name">Furniture &amp; Home</field>
        <field name="url" eval="'/shop/category/%d' % ref('public_category_furniture')"/>
        <field name="parent_id" ref="lifestyle_connector.restored_menu_shop"/>
        <field name="sequence">1</field>
    </record>
    <record id="menu_shop_fruits_veg" model="website.menu">
        <field name="name">Fruits &amp; Vegetables</field>
        <field name="url" eval="'/shop/category/%d' % ref('public_category_fruits_veg')"/>
        <field name="parent_id" ref="lifestyle_connector.restored_menu_shop"/>
        <field name="sequence">2</field>
    </record>
    <record id="menu_shop_pantry" model="website.menu">
        <field name="name">Healthy Pantry</field>
        <field name="url" eval="'/shop/category/%d' % ref('public_category_pantry')"/>
        <field name="parent_id" ref="lifestyle_connector.restored_menu_shop"/>
        <field name="sequence">3</field>
    </record>
</odoo>
