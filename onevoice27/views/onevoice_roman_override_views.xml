<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ─── Roman Urdu Overrides ─────────────────────────────── -->

    <record id="view_onevoice_roman_override_list" model="ir.ui.view">
        <field name="name">onevoice.roman.override.list</field>
        <field name="model">onevoice.roman.override</field>
        <field name="arch" type="xml">
            <list string="Roman Urdu Overrides" editable="bottom">
                <field name="source_text" string="English Text"  required="1"/>
                <field name="roman_text"  string="Roman Urdu"    required="1"/>
                <field name="notes"       string="Notes"         optional="show"/>
                <field name="is_active"   string="Active"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_roman_override_form" model="ir.ui.view">
        <field name="name">onevoice.roman.override.form</field>
        <field name="model">onevoice.roman.override</field>
        <field name="arch" type="xml">
            <form string="Roman Urdu Override">
                <sheet>
                    <group>
                        <group string="Translation">
                            <field name="source_text"
                                   placeholder="English word or phrase…"/>
                            <field name="roman_text"
                                   placeholder="Roman Urdu (e.g. Daniel aur Mukashfa)…"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Admin Notes">
                            <field name="notes"
                                   placeholder="Optional — where is this used?"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>How it works:</strong>
                        When a user enables Roman Urdu in the app, the app checks this table first.
                        If the English text matches exactly, your Roman Urdu text is shown.
                        Useful for names, Bible terms, or any phrase you want to control exactly.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onevoice_roman_override" model="ir.actions.act_window">
        <field name="name">Roman Urdu Overrides</field>
        <field name="res_model">onevoice.roman.override</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
