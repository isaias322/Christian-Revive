<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Re-applies on every module upgrade (no noupdate="1"). Runs as a
         Python method rather than writing a hard-coded website record:
         see Website._rl_apply_lifestyle_branding for why - a fixed xmlid
         silently updated the wrong website record once a second,
         hand-created one existed for a real custom domain. -->
    <function model="website" name="_rl_apply_lifestyle_branding" eval="[]"/>
</odoo>
