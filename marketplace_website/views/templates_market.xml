<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Marketplace home                                             -->
    <!-- ============================================================ -->
    <template id="market_home" name="Marketplace Home">
        <t t-call="website.layout">
            <t t-call="marketplace_website.mk_navbar"/>
            <div class="mk-hero py-5 text-center">
                <div class="container">
                    <h1 class="display-5 fw-bold">Buy &amp; sell pre-loved fashion</h1>
                    <p class="lead mb-4">Zero seller fees. Buyer protection on every order. From Instagram shop to real shop in minutes.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a href="/market/search" class="btn mk-btn btn-lg">Start Shopping</a>
                        <a href="/market/sell" class="btn btn-outline-dark btn-lg">Start Selling</a>
                    </div>
                </div>
            </div>

            <div class="container py-4">
                <t t-if="following">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">From shops you follow</h4>
                    </div>
                    <div class="row g-3 mb-4">
                        <t t-foreach="following" t-as="listing">
                            <div class="col-6 col-md-3 col-lg-2th">
                                <t t-call="marketplace_website.listing_card"/>
                            </div>
                        </t>
                    </div>
                </t>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="mb-0">Newest items</h4>
                    <a href="/market/search?sort=newest" class="small">See all</a>
                </div>
                <div class="row g-3 mb-4">
                    <t t-foreach="newest" t-as="listing">
                        <div class="col-6 col-md-3 col-lg-2th">
                            <t t-call="marketplace_website.listing_card"/>
                        </div>
                    </t>
                    <div t-if="not newest" class="col-12 text-center text-muted py-5">
                        No items yet — be the first to <a href="/market/sell">list something</a>!
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="mb-0">Popular right now</h4>
                    <a href="/market/search?sort=popular" class="small">See all</a>
                </div>
                <div class="row g-3 mb-4">
                    <t t-foreach="popular" t-as="listing">
                        <div class="col-6 col-md-3 col-lg-2th">
                            <t t-call="marketplace_website.listing_card"/>
                        </div>
                    </t>
                </div>

                <t t-if="featured_shops">
                    <h4 class="mb-2">Shops to discover</h4>
                    <div class="row g-3 mb-4">
                        <t t-foreach="featured_shops" t-as="shop">
                            <div class="col-6 col-md-4 col-lg-2">
                                <a t-attf-href="/market/shop/#{shop.slug}"
                                   class="mk-shop-tile card p-3 text-center text-decoration-none h-100">
                                    <img t-attf-src="/web/image/marketplace.seller/#{shop.id}/logo/128x128"
                                         class="rounded-circle mx-auto mb-2 mk-shop-logo" alt="shop"/>
                                    <div class="fw-bold text-truncate" t-out="shop.name"/>
                                    <div class="small text-muted">
                                        <i class="fa fa-star text-warning"/>
                                        <t t-out="'%.1f' % shop.rating_avg"/> ·
                                        <t t-out="shop.active_listing_count"/> items
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </t>

                <div class="mk-trust row text-center py-4 g-3">
                    <div class="col-md-4">
                        <i class="fa fa-shield fa-2x mb-2"/>
                        <h6>Buyer Protection</h6>
                        <p class="small text-muted mb-0">Your money is held safely in escrow until you confirm delivery.</p>
                    </div>
                    <div class="col-md-4">
                        <i class="fa fa-truck fa-2x mb-2"/>
                        <h6>Integrated Shipping</h6>
                        <p class="small text-muted mb-0">Prepaid labels with TCS, Leopards, M&amp;P and BlueEx — COD supported.</p>
                    </div>
                    <div class="col-md-4">
                        <i class="fa fa-money fa-2x mb-2"/>
                        <h6>Zero Seller Fees</h6>
                        <p class="small text-muted mb-0">List and sell for free. Get paid to your bank, JazzCash or EasyPaisa.</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Search & browse                                              -->
    <!-- ============================================================ -->
    <template id="market_search" name="Marketplace Search">
        <t t-call="website.layout">
            <t t-call="marketplace_website.mk_navbar"/>
            <div class="container py-4">
                <div class="row">
                    <!-- Filters -->
                    <div class="col-lg-3 mb-4">
                        <form action="/market/search" method="get" class="card p-3 mk-filters">
                            <h6 class="fw-bold mb-3">Filters</h6>
                            <input type="hidden" name="search" t-att-value="filters.get('search')"/>
                            <label class="form-label small fw-bold">Category</label>
                            <select name="category_id" class="form-select form-select-sm mb-3">
                                <option value="">All categories</option>
                                <t t-foreach="all_categories" t-as="cat">
                                    <option t-att-value="cat.id"
                                            t-att-selected="filters.get('category_id') == str(cat.id) and 'selected' or None">
                                        <t t-if="cat.parent_id" t-out="cat.parent_id.name + ' / ' + cat.name"/>
                                        <t t-else="" t-out="cat.name"/>
                                    </option>
                                </t>
                            </select>
                            <label class="form-label small fw-bold">Brand</label>
                            <select name="brand_id" class="form-select form-select-sm mb-3">
                                <option value="">All brands</option>
                                <t t-foreach="brands" t-as="brand">
                                    <option t-att-value="brand.id"
                                            t-att-selected="filters.get('brand_id') == str(brand.id) and 'selected' or None"
                                            t-out="brand.name"/>
                                </t>
                            </select>
                            <label class="form-label small fw-bold">Size</label>
                            <select name="size_id" class="form-select form-select-sm mb-3">
                                <option value="">All sizes</option>
                                <t t-foreach="sizes" t-as="size">
                                    <option t-att-value="size.id"
                                            t-att-selected="filters.get('size_id') == str(size.id) and 'selected' or None">
                                        <t t-out="size.name"/> (<t t-out="dict(size._fields['category'].selection).get(size.category)"/>)
                                    </option>
                                </t>
                            </select>
                            <label class="form-label small fw-bold">Condition</label>
                            <select name="condition" class="form-select form-select-sm mb-3">
                                <option value="">Any condition</option>
                                <t t-foreach="conditions" t-as="cond">
                                    <option t-att-value="cond[0]"
                                            t-att-selected="filters.get('condition') == cond[0] and 'selected' or None"
                                            t-out="cond[1]"/>
                                </t>
                            </select>
                            <label class="form-label small fw-bold">Price</label>
                            <div class="d-flex gap-2 mb-3">
                                <input type="number" name="min_price" class="form-control form-control-sm"
                                       placeholder="Min" t-att-value="filters.get('min_price')"/>
                                <input type="number" name="max_price" class="form-control form-control-sm"
                                       placeholder="Max" t-att-value="filters.get('max_price')"/>
                            </div>
                            <label class="form-label small fw-bold">Sort by</label>
                            <select name="sort" class="form-select form-select-sm mb-3">
                                <option value="newest" t-att-selected="filters.get('sort') == 'newest' and 'selected' or None">Newest</option>
                                <option value="price_asc" t-att-selected="filters.get('sort') == 'price_asc' and 'selected' or None">Price: low to high</option>
                                <option value="price_desc" t-att-selected="filters.get('sort') == 'price_desc' and 'selected' or None">Price: high to low</option>
                                <option value="popular" t-att-selected="filters.get('sort') == 'popular' and 'selected' or None">Most viewed</option>
                            </select>
                            <button class="btn mk-btn btn-sm" type="submit">Apply Filters</button>
                            <a href="/market/search" class="btn btn-link btn-sm">Clear all</a>
                        </form>
                    </div>
                    <!-- Results -->
                    <div class="col-lg-9">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">
                                <t t-if="filters.get('search')">Results for "<t t-out="filters['search']"/>"</t>
                                <t t-else="">Browse items</t>
                            </h5>
                            <span class="text-muted small"><t t-out="total"/> items</span>
                        </div>
                        <div class="row g-3">
                            <t t-foreach="listings" t-as="listing">
                                <div class="col-6 col-md-4 col-lg-3">
                                    <t t-call="marketplace_website.listing_card"/>
                                </div>
                            </t>
                            <div t-if="not listings" class="col-12 text-center text-muted py-5">
                                <i class="fa fa-search fa-2x mb-2"/>
                                <p>No items match your search. Try removing some filters.</p>
                            </div>
                        </div>
                        <!-- Pagination -->
                        <nav t-if="page_count > 1" class="mt-4">
                            <ul class="pagination justify-content-center">
                                <t t-set="qs" t-value="'&amp;'.join(['%s=%s' % (k, v) for k, v in filters.items() if k != 'page' and v])"/>
                                <t t-foreach="range(1, page_count + 1)" t-as="p">
                                    <li t-attf-class="page-item #{p == page and 'active' or ''}">
                                        <a class="page-link" t-attf-href="/market/search?page=#{p}&amp;#{qs}" t-out="p"/>
                                    </li>
                                </t>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Favourites                                                   -->
    <!-- ============================================================ -->
    <template id="market_favorites" name="My Favourites">
        <t t-call="website.layout">
            <t t-call="marketplace_website.mk_navbar"/>
            <div class="container py-4">
                <h4 class="mb-3"><i class="fa fa-heart text-danger me-2"/>My Favourites</h4>
                <div class="row g-3">
                    <t t-foreach="listings" t-as="listing">
                        <div class="col-6 col-md-3 col-lg-2th">
                            <t t-call="marketplace_website.listing_card"/>
                        </div>
                    </t>
                    <div t-if="not listings" class="col-12 text-center text-muted py-5">
                        <i class="fa fa-heart-o fa-2x mb-2"/>
                        <p>Nothing saved yet. Tap the heart on items you love.</p>
                        <a href="/market/search" class="btn mk-btn">Browse items</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
