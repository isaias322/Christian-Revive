<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="market_shop_create" name="Create Your Shop">
        <t t-call="website.layout">
            <t t-call="marketplace_website.mk_navbar"/>
            <div class="container py-5" style="max-width: 640px;">
                <div class="text-center mb-4">
                    <h2>Open your shop</h2>
                    <p class="text-muted">Free forever. No listing fees, no commission.
                       Bring your Instagram shop to a real storefront.</p>
                </div>
                <t t-call="marketplace_website.mk_alert"/>
                <form action="/market/sell/create" method="post" enctype="multipart/form-data" class="card p-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Shop name *</label>
                        <input type="text" name="shop_name" class="form-control" required="required"
                               placeholder="e.g. Mahnoor's Closet"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Shop logo</label>
                        <input type="file" name="logo" class="form-control" accept="image/*"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Bio</label>
                        <textarea name="bio" class="form-control" rows="3"
                                  placeholder="Tell buyers what you sell..."/>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">City</label>
                            <input type="text" name="city" class="form-control" placeholder="Lahore"/>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Instagram handle</label>
                            <input type="text" name="instagram_handle" class="form-control" placeholder="@yourshop"/>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">WhatsApp number</label>
                        <input type="text" name="whatsapp_number" class="form-control" placeholder="+92 3xx xxxxxxx"/>
                    </div>
                    <button type="submit" class="btn mk-btn btn-lg">Create My Shop</button>
                    <p class="small text-muted mt-3 mb-0">
                        You can start listing immediately. ID verification (KYC) is only
                        needed before your first payout.
                    </p>
                </form>
            </div>
        </t>
    </template>
</odoo>
