<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ─── Roman Word Overrides (shown in Urdu mode) ────────── -->

    <record id="view_onevoice_roman_override_list" model="ir.ui.view">
        <field name="name">onevoice.roman.override.list</field>
        <field name="model">onevoice.roman.override</field>
        <field name="arch" type="xml">
            <list string="Roman Word Overrides" editable="bottom">
                <field name="source_text" string="Urdu Word / Phrase"  required="1"/>
                <field name="roman_text"  string="Roman Replacement"   required="1"/>
                <field name="notes"       string="Notes"               optional="show"/>
                <field name="is_active"   string="Active"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_roman_override_form" model="ir.ui.view">
        <field name="name">onevoice.roman.override.form</field>
        <field name="model">onevoice.roman.override</field>
        <field name="arch" type="xml">
            <form string="Roman Word Override">
                <sheet>
                    <group>
                        <group string="Override">
                            <field name="source_text"
                                   placeholder="Urdu word or phrase to replace (e.g. ایمانوایل)"/>
                            <field name="roman_text"
                                   placeholder="Roman/Latin replacement (e.g. Immanuel)"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Admin Notes">
                            <field name="notes"
                                   placeholder="Optional — where is this used?"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>How it works:</strong>
                        When a user selects Urdu in the app, the app scans the chapter text for
                        any Urdu word listed here and replaces it with the Roman text you provide.
                        Both the displayed text and the TTS voice use the Roman replacement.
                        Useful for proper nouns or terms that are clearer in Latin script.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onevoice_roman_override" model="ir.actions.act_window">
        <field name="name">Roman Word Overrides</field>
        <field name="res_model">onevoice.roman.override</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
