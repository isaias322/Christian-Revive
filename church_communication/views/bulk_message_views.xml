<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_church_bulk_message_list" model="ir.ui.view">
        <field name="name">church.bulk.message.list</field>
        <field name="model">church.bulk.message</field>
        <field name="arch" type="xml">
            <list string="Bulk Messages">
                <field name="title"/>
                <field name="segment_type"/>
                <field name="recipient_count"/>
                <field name="sent_at"/>
                <field name="sent_by_id"/>
            </list>
        </field>
    </record>

    <record id="view_church_bulk_message_form" model="ir.ui.view">
        <field name="name">church.bulk.message.form</field>
        <field name="model">church.bulk.message</field>
        <field name="arch" type="xml">
            <form string="Bulk Message">
                <header>
                    <button name="action_send" type="object" string="Send"
                            class="btn-primary" invisible="sent_at != False"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Title..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="segment_type"/>
                            <field name="cell_group_id" invisible="segment_type != 'cell_group'"/>
                            <field name="inactive_days" invisible="segment_type != 'inactive'"/>
                        </group>
                        <group>
                            <field name="sent_at"/>
                            <field name="recipient_count"/>
                            <field name="sent_by_id"/>
                        </group>
                    </group>
                    <field name="message" placeholder="Message..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_church_bulk_messages" model="ir.actions.act_window">
        <field name="name">Bulk Messages</field>
        <field name="res_model">church.bulk.message</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
