<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="market_shop" name="Marketplace Shop Page">
        <t t-call="website.layout">
            <t t-call="marketplace_website.mk_navbar"/>
            <!-- Banner -->
            <div t-attf-class="mk-shop-banner #{'' if seller.banner else 'mk-shop-banner-fallback'}"
                 t-attf-style="#{'background-image: url(\'/web/image/marketplace.seller/%s/banner\');' % seller.id if seller.banner else ''}">
            </div>
            <div class="container">
                <div class="mk-shop-head card p-3">
                    <div class="d-flex flex-row align-items-center gap-3 flex-wrap">
                        <img t-attf-src="/web/image/marketplace.seller/#{seller.id}/logo/128x128"
                             class="rounded-circle mk-shop-logo-lg" alt="shop logo"/>
                        <div class="flex-grow-1">
                            <h3 class="mb-0 mk-font-display">
                                <t t-out="seller.name"/>
                                <i t-if="seller.kyc_status == 'verified'"
                                   class="fa fa-check-circle" style="color: var(--mk-primary);" title="Verified seller"/>
                            </h3>
                            <div t-if="seller.city" class="text-muted small mt-1">
                                <i class="fa fa-map-marker"/> <t t-out="seller.city"/>
                            </div>
                            <p t-if="seller.bio" class="mb-0 mt-1 small" t-out="seller.bio"/>
                            <div t-if="seller.instagram_handle or seller.whatsapp_number" class="d-flex gap-2 flex-wrap mt-2">
                                <a t-if="seller.instagram_handle"
                                   t-attf-href="https://instagram.com/#{seller.instagram_handle.lstrip('@')}"
                                   target="_blank" class="mk-contact-chip">
                                    <i class="fa fa-camera"/> @<t t-out="seller.instagram_handle.lstrip('@')"/>
                                </a>
                                <a t-if="seller.whatsapp_number"
                                   t-attf-href="https://wa.me/#{''.join(c for c in seller.whatsapp_number if c.isdigit())}"
                                   target="_blank" class="mk-contact-chip">
                                    <i class="fa fa-whatsapp"/> <t t-out="seller.whatsapp_number"/>
                                </a>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button t-if="is_logged and not is_own" id="mkFollowBtn"
                                    t-att-data-seller-id="seller.id"
                                    t-att-data-following="is_following and '1' or '0'"
                                    t-attf-class="btn #{is_following and 'btn-dark' or 'mk-btn'}">
                                <t t-if="is_following">Following</t>
                                <t t-else="">Follow</t>
                            </button>
                            <a t-if="not is_logged" t-attf-href="/web/login?redirect=/market/shop/#{seller.slug}"
                               class="btn mk-btn">Follow</a>
                            <form t-if="is_logged and not is_own" action="/market/messages/start" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="seller_id" t-att-value="seller.id"/>
                                <button type="submit" class="btn btn-outline-dark">
                                    <i class="fa fa-comment"/> Message
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="mk-shop-stats row text-center g-0 mt-3">
                        <div class="col-4">
                            <div class="mk-shop-stat-value"><t t-out="'%.1f' % seller.rating_avg"/> ★</div>
                            <div class="mk-shop-stat-label"><t t-out="seller.review_count"/> reviews</div>
                        </div>
                        <div class="col-4">
                            <div class="mk-shop-stat-value" id="mkFollowCount" t-out="seller.follower_count"/>
                            <div class="mk-shop-stat-label">Followers</div>
                        </div>
                        <div class="col-4">
                            <div class="mk-shop-stat-value" t-out="seller.sold_listing_count"/>
                            <div class="mk-shop-stat-label">Sold</div>
                        </div>
                    </div>
                </div>

                <div t-if="seller.state == 'suspended'" class="alert alert-warning mt-3">
                    This shop is currently suspended.
                </div>

                <div t-if="seller.story" class="card p-3 mt-3">
                    <h6 class="fw-bold">Our story</h6>
                    <div t-out="seller.story"/>
                </div>

                <h5 class="mt-4 mb-3">Items (<t t-out="len(listings)"/>)</h5>
                <div class="row g-3">
                    <t t-foreach="listings" t-as="listing">
                        <div class="col-6 col-md-3 col-lg-2th">
                            <t t-call="marketplace_website.listing_card"/>
                        </div>
                    </t>
                    <div t-if="not listings" class="col-12 text-muted text-center py-4">
                        <i class="fa fa-shopping-bag fa-2x mb-2"/>
                        <p class="mb-0">This shop has no active listings right now.</p>
                    </div>
                </div>

                <t t-if="sold_listings">
                    <h5 class="mt-4 mb-3">Recently sold</h5>
                    <div class="row g-3">
                        <t t-foreach="sold_listings" t-as="listing">
                            <div class="col-6 col-md-3 col-lg-2th">
                                <t t-call="marketplace_website.listing_card"/>
                            </div>
                        </t>
                    </div>
                </t>

                <t t-if="reviews">
                    <h5 class="mt-4 mb-3">Reviews</h5>
                    <div class="row g-3 mb-5">
                        <t t-foreach="reviews" t-as="review">
                            <div class="col-md-6">
                                <div class="card p-3 h-100 d-flex flex-row gap-2">
                                    <div class="mk-review-avatar">
                                        <t t-out="(review.reviewer_id.name or '?')[0].upper()"/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between">
                                            <strong t-out="review.reviewer_id.name"/>
                                            <span class="text-warning">
                                                <t t-foreach="range(int(review.rating))" t-as="i"><i class="fa fa-star"/></t>
                                            </span>
                                        </div>
                                        <p class="mb-0 small" t-out="review.comment or ''"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
