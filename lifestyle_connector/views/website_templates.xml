<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Disable the default "30-day money-back / 2-3 Business Days" block — not accurate for a made-to-order furniture business. -->
    <record id="website_sale.product_custom_text" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- Every page goes through website.layout, so its <head> is a safe,
         universal place to load the brand fonts (kept out of the SCSS
         bundle - see lifestyle_web_theme.scss for why). -->
    <template id="lifestyle_web_fonts" inherit_id="website.layout" name="Revive Lifestyle Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&amp;family=Fraunces:wght@600&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <!-- Anchored on div#product_details, a stable top-level wrapper in
         website_sale.product - verified against the Odoo 18 source before
         writing this, same as the order-portal anchor below. -->
    <template id="lifestyle_product_extra_details" inherit_id="website_sale.product"
              name="Revive Lifestyle Product Details">
        <xpath expr="//div[@id='product_details']" position="inside">
            <div class="lifestyle-card mt-3"
                 t-if="product.store_description or product.store_rating or product.color_options or product.size_options or product.store_sold_count">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span t-if="product.store_rating" class="lifestyle-badge">
                        <t t-esc="'%.1f' % product.store_rating"/> rating
                        (<t t-esc="product.store_review_count"/>
                        <t t-esc="'review' if product.store_review_count == 1 else 'reviews'"/>)
                    </span>
                    <span t-if="product.store_sold_count" class="lifestyle-badge">
                        <t t-esc="product.store_sold_count"/> sold
                    </span>
                </div>
                <p t-if="product.store_description" t-esc="product.store_description"/>
                <p t-if="product.color_options" class="mb-1">
                    <strong>Colors:</strong> <t t-esc="product.color_options"/>
                </p>
                <p t-if="product.size_options" class="mb-0">
                    <strong>Sizes:</strong> <t t-esc="product.size_options"/>
                </p>
            </div>

            <div id="notify_stock" class="lifestyle-card mt-3"
                 t-if="product.type in ('consu', 'product') and product.sudo().qty_available &lt;= 0">
                <h6 class="mb-2">Notify me when back in stock</h6>
                <p t-if="request.params.get('notify_success')" class="text-success mb-0">
                    Thanks! We'll let you know when this is back in stock.
                </p>
                <form t-else="" t-attf-action="/shop/product/#{product.id}/notify-stock" method="post"
                      class="d-flex gap-2 flex-wrap">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="email" name="email" class="form-control" style="max-width: 280px;"
                           placeholder="Your email" required="required"/>
                    <button type="submit" class="btn btn-primary">Notify Me</button>
                </form>
            </div>

            <div id="reviews" class="lifestyle-card mt-3">
                <h5 class="mb-3">Customer Reviews</h5>
                <div t-if="not product.review_ids" class="text-muted mb-3">No reviews yet.</div>
                <div t-foreach="product.review_ids" t-as="review" class="mb-3 pb-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-start">
                        <strong t-esc="review.partner_id.sudo().name or 'Customer'"/>
                        <span class="lifestyle-badge"><t t-esc="review.rating"/>/5</span>
                    </div>
                    <p t-if="review.comment" t-esc="review.comment" class="mb-0 mt-1"/>
                </div>

                <t t-set="current_partner"
                   t-value="(not request.env.user._is_public()) and request.env.user.partner_id"/>
                <t t-if="current_partner">
                    <t t-set="my_review" t-value="product.review_ids.filtered(lambda r: r.partner_id.id == current_partner.id)"/>
                    <h6 class="mt-4 mb-2">
                        <t t-esc="'Update your review' if my_review else 'Write a review'"/>
                    </h6>
                    <form t-attf-action="/shop/product/#{product.id}/review/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-2">
                            <select name="rating" class="form-select" style="max-width: 160px;">
                                <t t-foreach="[5, 4, 3, 2, 1]" t-as="star">
                                    <option t-att-value="star"
                                            t-att-selected="'selected' if (my_review and my_review.rating == star) else None">
                                        <t t-esc="star"/> stars
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="mb-2">
                            <textarea name="comment" class="form-control" rows="3"
                                      placeholder="Share your thoughts (optional)"
                                      t-esc="my_review.comment if my_review else ''"/>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Submit Review</button>
                    </form>
                </t>
                <t t-else="">
                    <p class="text-muted mt-3 mb-0">
                        <a t-attf-href="/web/login?redirect=#{product.website_url}">Log in</a> to write a review.
                    </p>
                </t>
            </div>
        </xpath>
    </template>

    <!-- Replaces the whole #wrap div rather than patching its current
         contents, since the homepage's body is onboarding-generated content
         stored in the database (not the module's own static template) -
         #wrap itself is the one anchor guaranteed to exist regardless of
         whatever placeholder content is currently inside it. -->
    <template id="lifestyle_homepage" inherit_id="website.homepage" name="Revive Lifestyle Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <section class="py-5" style="background-color: #F7F5F0;">
                    <div class="container py-5 text-center">
                        <h1 class="display-4 mb-3">Furniture, fresh produce &amp; pantry essentials</h1>
                        <p class="lead text-muted mb-4">
                            Everything for your home, delivered or ready for pickup - with build progress
                            and delivery tracked every step of the way.
                        </p>
                        <a href="/shop" class="btn btn-primary btn-lg">Shop Now</a>
                    </div>
                </section>
                <section class="py-5">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-12 col-md-4">
                                <div class="lifestyle-card h-100 text-center">
                                    <h4 class="mb-2">Furniture &amp; Home</h4>
                                    <p class="text-muted mb-3">Handmade pieces, built to order and tracked from
                                        workshop to your door.</p>
                                    <a href="/shop" class="btn btn-outline-secondary">Browse Furniture</a>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="lifestyle-card h-100 text-center">
                                    <h4 class="mb-2">Fruits &amp; Vegetables</h4>
                                    <p class="text-muted mb-3">Fresh produce, picked and packed for delivery
                                        or in-store pickup.</p>
                                    <a href="/shop" class="btn btn-outline-secondary">Browse Produce</a>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="lifestyle-card h-100 text-center">
                                    <h4 class="mb-2">Healthy Pantry</h4>
                                    <p class="text-muted mb-3">Pantry staples and healthy essentials for
                                        everyday cooking.</p>
                                    <a href="/shop" class="btn btn-outline-secondary">Browse Pantry</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="py-5" style="background-color: #E3EADB;">
                    <div class="container text-center">
                        <h3 class="mb-3">Track every order, every step</h3>
                        <p class="text-muted mb-0">
                            From order placed to build started, packing, and delivery - follow your
                            furniture's progress and see workshop photos as they're sent, right from
                            your account.
                        </p>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <template id="lifestyle_homepage_direct_page" name="Revive Lifestyle Home Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure rl-home-page">
                <section class="rl-home-hero rl-home-hero--dynamic" data-rl-home-slider="1">
                    <div class="rl-home-hero-bg" aria-hidden="true"></div>
                    <div class="rl-home-hero-track">
                        <div t-foreach="homepage_slides" t-as="slide" t-att-class="'container position-relative rl-home-hero-content-slide rl-home-hero-style-' + (slide.background_style or 'charcoal') + (' is-active' if slide_index == 0 else '')" t-att-data-rl-slide-index="slide_index">
                            <div t-if="slide.image" class="rl-home-slide-image-bg" t-attf-style="background-image: linear-gradient(90deg, rgba(37, 40, 33, 0.92), rgba(37, 40, 33, 0.72)), url('/web/image/lifestyle.homepage.slide/#{slide.id}/image');"></div>
                            <div class="row align-items-center g-5">
                                <div class="col-12 col-lg-6">
                                    <span class="rl-home-kicker" t-esc="slide.kicker"/>
                                    <h1 t-esc="slide.title"/>
                                    <p t-if="slide.subtitle" t-esc="slide.subtitle"/>
                                    <div class="rl-home-actions">
                                        <a t-if="slide.primary_button_label" t-att-href="slide.primary_button_url or '/shop'" class="btn btn-primary btn-lg" t-esc="slide.primary_button_label"/>
                                        <a t-if="slide.secondary_button_label" t-att-href="slide.secondary_button_url or '/contactus'" class="btn btn-outline-light btn-lg" t-esc="slide.secondary_button_label"/>
                                    </div>
                                    <div class="rl-home-trust-row">
                                        <span t-if="slide.trust_1_text"><i t-att-class="'fa ' + (slide.trust_1_icon or 'fa-check')"></i> <t t-esc="slide.trust_1_text"/></span>
                                        <span t-if="slide.trust_2_text"><i t-att-class="'fa ' + (slide.trust_2_icon or 'fa-camera')"></i> <t t-esc="slide.trust_2_text"/></span>
                                        <span t-if="slide.trust_3_text"><i t-att-class="'fa ' + (slide.trust_3_icon or 'fa-truck')"></i> <t t-esc="slide.trust_3_text"/></span>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <div class="rl-home-showcase">
                                        <div class="rl-home-showcase-card rl-home-showcase-main">
                                            <img t-if="slide.image" class="rl-home-card-image" t-att-src="'/web/image/lifestyle.homepage.slide/%s/image' % slide.id" t-att-alt="slide.title" loading="lazy"/>
                                            <span class="rl-home-room-line"></span>
                                            <i t-att-class="'fa ' + (slide.card_icon or 'fa-home')"></i>
                                            <h3 t-esc="slide.card_title or slide.title"/>
                                            <p t-if="slide.card_text" t-esc="slide.card_text"/>
                                        </div>
                                        <div class="rl-home-floating-card rl-home-floating-one" t-if="slide.badge_1_value or slide.badge_1_label">
                                            <strong t-if="slide.badge_1_value" t-esc="slide.badge_1_value"/>
                                            <span t-if="slide.badge_1_label" t-esc="slide.badge_1_label"/>
                                        </div>
                                        <div class="rl-home-floating-card rl-home-floating-two" t-if="slide.badge_2_icon or slide.badge_2_label">
                                            <i t-if="slide.badge_2_icon" t-att-class="'fa ' + slide.badge_2_icon"></i>
                                            <span t-if="slide.badge_2_label" t-esc="slide.badge_2_label"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button t-if="len(homepage_slides) > 1" type="button" class="rl-home-arrow rl-home-arrow-prev" data-rl-home-prev="1" aria-label="Previous homepage slide">
                            <i class="fa fa-chevron-left"></i>
                        </button>
                        <button t-if="len(homepage_slides) > 1" type="button" class="rl-home-arrow rl-home-arrow-next" data-rl-home-next="1" aria-label="Next homepage slide">
                            <i class="fa fa-chevron-right"></i>
                        </button>
                        <div t-if="len(homepage_slides) > 1" class="rl-home-hero-dots" aria-label="Homepage slide controls">
                            <button t-foreach="homepage_slides" t-as="slide_dot" type="button" class="rl-home-hero-dot" t-att-data-rl-home-dot="slide_dot_index" t-att-aria-current="'true' if slide_dot_index == 0 else None" t-att-aria-label="'Go to slide %s' % (slide_dot_index + 1)"></button>
                        </div>
                    </div>
                </section>

                <section class="rl-home-featured">
                    <div class="container">
                        <div class="rl-home-section-head">
                            <span class="rl-home-kicker text-sage">Featured Pieces</span>
                            <h2>Start with what your home needs</h2>
                            <a href="/shop" class="rl-home-link">View all products <i class="fa fa-arrow-right"></i></a>
                        </div>
                        <div t-if="featured_products" class="row g-4">
                            <div t-foreach="featured_products" t-as="product" class="col-12 col-sm-6 col-lg-3">
                                <a t-att-href="product.website_url or ('/shop/product/%s' % product.id)" class="rl-home-product-card">
                                    <div class="rl-home-product-image">
                                        <img t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/>
                                    </div>
                                    <div class="rl-home-product-body">
                                        <span t-if="product.public_categ_ids" t-esc="product.public_categ_ids[0].name"/>
                                        <h3 t-esc="product.name"/>
                                        <strong>
                                            <t t-esc="product.currency_id.symbol or 'Rs.'"/>
                                            <t t-esc="'%.2f' % product.list_price"/>
                                        </strong>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div t-else="" class="rl-home-empty-products">
                            <h3>Products will appear here when you publish them for Revive Lifestyle.</h3>
                            <a href="/shop" class="btn btn-primary">Go to Shop</a>
                        </div>
                    </div>
                </section>

                <section class="rl-home-process">
                    <div class="container">
                        <div class="row g-4 align-items-center">
                            <div class="col-12 col-lg-5">
                                <span class="rl-home-kicker text-sage">Order Confidence</span>
                                <h2>Customers can follow every step</h2>
                                <p>
                                    Revive Lifestyle is built for furniture orders where customers care about progress.
                                    From order placed to build, packing, delivery, and invoice, the flow stays clear.
                                </p>
                            </div>
                            <div class="col-12 col-lg-7">
                                <div class="rl-home-process-grid">
                                    <div><i class="fa fa-shopping-bag"></i><strong>Order placed</strong><span>Customer chooses the product and quantity.</span></div>
                                    <div><i class="fa fa-wrench"></i><strong>Build starts</strong><span>Vendor updates progress from their side.</span></div>
                                    <div><i class="fa fa-camera"></i><strong>Photo updates</strong><span>Images, videos, and notes can be shared.</span></div>
                                    <div><i class="fa fa-truck"></i><strong>Delivered</strong><span>The order reaches the customer with a clear record.</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="rl-home-cta">
                    <div class="container">
                        <div class="rl-home-cta-panel">
                            <div>
                                <span class="rl-home-kicker">Need help choosing?</span>
                                <h2>Tell us your room, color, and size.</h2>
                                <p>We can help with furniture questions before you order.</p>
                            </div>
                            <a href="/contactus" class="btn btn-primary btn-lg">Contact Us</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    <!-- Anchored on div#introduction, a stable top-level child of
         sale.sale_order_portal_content that has existed across many Odoo
         versions - verified against the Odoo 18 source before writing this,
         to avoid an xpath-not-found error blocking the whole module install. -->
    <template id="portal_order_lifestyle_progress" inherit_id="sale.sale_order_portal_content"
              name="Revive Lifestyle Delivery Progress">
        <xpath expr="//div[@id='introduction']" position="after">
            <div t-if="sale_order.delivery_stage" class="lifestyle-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Furniture Progress</h5>
                    <span class="lifestyle-badge">
                        <t t-esc="sale_order.lifestyle_progress_percent"/>%
                    </span>
                </div>
                <div class="lifestyle-progress mb-3">
                    <div t-attf-style="width: #{sale_order.lifestyle_progress_percent}%;"/>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <t t-foreach="sale_order._lifestyle_timeline()" t-as="step">
                        <span t-attf-class="lifestyle-badge #{'' if step['done'] else 'opacity-50'}">
                            <t t-esc="step['label']"/>
                            <t t-if="step['current']"> (current)</t>
                        </span>
                    </t>
                </div>
            </div>
            <t t-set="lifestyle_media" t-value="sale_order._lifestyle_media_list()"/>
            <div t-if="lifestyle_media" class="lifestyle-card mb-4">
                <h5 class="mb-3">Latest Workshop Update</h5>
                <t t-set="latest" t-value="lifestyle_media[0]"/>
                <span t-if="latest['stage_label']" class="lifestyle-badge mb-2 d-inline-block">
                    <t t-esc="latest['stage_label']"/>
                </span>
                <div t-if="latest['url'] and not latest['mimetype'].startswith('video/')" class="mb-2">
                    <img t-att-src="latest['url']" class="img-fluid rounded" style="max-height: 320px; object-fit: cover;"/>
                </div>
                <div t-if="latest['url'] and latest['mimetype'].startswith('video/')" class="mb-2">
                    <video controls="controls" class="img-fluid rounded" style="max-height: 320px;">
                        <source t-att-src="latest['url']" t-att-type="latest['mimetype']"/>
                    </video>
                </div>
                <p t-if="latest['comment']" t-esc="latest['comment']" class="mb-0"/>
            </div>
        </xpath>
    </template>
    <template id="lifestyle_contactus_page" inherit_id="website.contactus" name="Revive Lifestyle Contact Page">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure rl-contact-page">
                <section class="rl-contact-hero">
                    <div class="container position-relative">
                        <div class="row align-items-end g-4">
                            <div class="col-12 col-lg-7">
                                <span class="rl-contact-kicker">Revive Lifestyle Support</span>
                                <h1>LetÃ¢â‚¬â„¢s shape your home together</h1>
                                <p>
                                    Questions about a furniture piece, custom finish, delivery, or an active order?
                                    Send a note and our team will help you with the next clear step.
                                </p>
                                <div class="rl-contact-hero-actions">
                                    <a href="#rl_contact_form" class="btn btn-primary btn-lg">Write to Us</a>
                                    <a href="/shop" class="btn btn-outline-light btn-lg">Browse Furniture</a>
                                </div>
                            </div>
                            <div class="col-12 col-lg-5">
                                <div class="rl-contact-hero-card">
                                    <img src="/lifestyle_connector/static/src/img/logo_wordmark.png" class="rl-contact-logo-mark" alt="Revive Lifestyle"/>
                                    <div class="rl-contact-swatch rl-contact-swatch-dark"></div>
                                    <div class="rl-contact-swatch rl-contact-swatch-sage"></div>
                                    <div>
                                        <span>Response goal</span>
                                        <strong>Same business day</strong>
                                        <p>Order help, product details, custom furniture questions, and delivery support.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="rl-contact-content">
                    <div class="container">
                        <div class="row g-4 g-lg-5">
                            <div class="col-12 col-lg-7">
                                <div class="rl-contact-panel rl-animate-up" id="rl_contact_form">
                                    <span class="rl-contact-kicker text-sage">Contact Form</span>
                                    <h2>Tell us what you need</h2>
                                    <p class="text-muted mb-4">
                                        Share the product, room, order number, or delivery question. The more detail you add,
                                        the faster we can guide you.
                                    </p>
                                    <form action="/website/form/" method="post" enctype="multipart/form-data"
                                          class="s_website_form rl-contact-form"
                                          data-model_name="crm.lead" data-success-mode="redirect"
                                          data-success-page="/contactus-thank-you">
                                        <div class="row g-3">
                                            <div class="col-12 col-md-6 s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                                                <label class="form-label" for="rl_contact_name">Name *</label>
                                                <input id="rl_contact_name" type="text" name="contact_name" class="form-control" required="required"/>
                                            </div>
                                            <div class="col-12 col-md-6 s_website_form_field" data-type="tel" data-name="Field">
                                                <label class="form-label" for="rl_contact_phone">Phone Number</label>
                                                <input id="rl_contact_phone" type="tel" name="phone" class="form-control"/>
                                            </div>
                                            <div class="col-12 col-md-6 s_website_form_field s_website_form_required" data-type="email" data-name="Field">
                                                <label class="form-label" for="rl_contact_email">Email *</label>
                                                <input id="rl_contact_email" type="email" name="email_from" class="form-control" required="required"/>
                                            </div>
                                            <div class="col-12 col-md-6 s_website_form_field" data-type="char" data-name="Field">
                                                <label class="form-label" for="rl_contact_company">Company</label>
                                                <input id="rl_contact_company" type="text" name="partner_name" class="form-control"/>
                                            </div>
                                            <div class="col-12 s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                                                <label class="form-label" for="rl_contact_subject">Subject *</label>
                                                <input id="rl_contact_subject" type="text" name="name" class="form-control" required="required"/>
                                            </div>
                                            <div class="col-12 s_website_form_field s_website_form_required" data-type="text" data-name="Field">
                                                <label class="form-label" for="rl_contact_question">Question *</label>
                                                <textarea id="rl_contact_question" name="description" class="form-control" rows="7" required="required"></textarea>
                                            </div>
                                            <div class="col-12 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 pt-2">
                                                <p class="rl-contact-note mb-0">We usually reply with product guidance, delivery options, or order next steps.</p>
                                                <button type="submit" class="btn btn-primary btn-lg s_website_form_send">Send Message</button>
                                                <span id="s_website_form_result"></span>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                            <div class="col-12 col-lg-5">
                                <div class="rl-contact-stack">
                                    <div class="rl-contact-info-card rl-animate-up rl-delay-1">
                                        <span class="rl-contact-kicker text-sage">Visit &amp; Support</span>
                                        <h3>Revive Lifestyle</h3>
                                        <ul class="rl-contact-list">
                                            <li><i class="fa fa-map-marker"></i><span>Karachi, Pakistan</span></li>
                                            <li><i class="fa fa-phone"></i><span>+1 555-555-5556</span></li>
                                            <li><i class="fa fa-envelope"></i><span>info@yourcompany.example.com</span></li>
                                        </ul>
                                    </div>
                                    <div class="rl-contact-mini-grid">
                                        <div class="rl-contact-mini rl-animate-up rl-delay-2">
                                            <i class="fa fa-truck"></i>
                                            <strong>Delivery help</strong>
                                            <span>Track handoff, delivery timing, and pickup questions.</span>
                                        </div>
