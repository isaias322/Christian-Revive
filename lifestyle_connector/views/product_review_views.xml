<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lifestyle_product_review_list" model="ir.ui.view">
        <field name="name">lifestyle.product.review.list</field>
        <field name="model">lifestyle.product.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_tmpl_id"/>
                <field name="partner_id"/>
                <field name="rating"/>
                <field name="comment"/>
                <field name="create_date" string="Submitted"/>
            </list>
        </field>
    </record>

    <record id="view_lifestyle_product_review_form" model="ir.ui.view">
        <field name="name">lifestyle.product.review.form</field>
        <field name="model">lifestyle.product.review</field>
        <field name="arch" type="xml">
            <form string="Product Review">
                <sheet>
                    <group>
                        <field name="product_tmpl_id"/>
                        <field name="partner_id"/>
                        <field name="rating"/>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lifestyle_product_review" model="ir.actions.act_window">
        <field name="name">Customer Reviews</field>
        <field name="res_model">lifestyle.product.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_lifestyle_product_review"
              name="Customer Reviews"
              parent="sale.sale_menu_root"
              action="action_lifestyle_product_review"
              sequence="96"/>
</odoo>
