<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ─── Book Chapter inline list ──────────────────────── -->

    <record id="view_onevoice_book_chapter_list" model="ir.ui.view">
        <field name="name">onevoice.book.chapter.list</field>
        <field name="model">onevoice.book.chapter</field>
        <field name="arch" type="xml">
            <list string="Chapters" default_order="chapter_number">
                <field name="chapter_number" string="Ch #"/>
                <field name="title_en"       string="English Title"/>
                <field name="title_ur"       string="Urdu Title"   optional="show"/>
                <field name="is_published"   string="Published"/>
                <field name="notes"          string="Notes"        optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_book_chapter_form" model="ir.ui.view">
        <field name="name">onevoice.book.chapter.form</field>
        <field name="model">onevoice.book.chapter</field>
        <field name="arch" type="xml">
            <form string="Chapter">
                <sheet>
                    <group>
                        <group string="Chapter Info">
                            <field name="book_id"        string="Book"/>
                            <field name="chapter_number" string="Chapter Number"/>
                            <field name="is_published"   string="Published"/>
                            <field name="notes"          string="Admin Notes"
                                   placeholder="Optional notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="English">
                            <group>
                                <field name="title_en" string="Title"
                                       placeholder="e.g. God With Us"/>
                                <field name="text_en"  string="Text" widget="text"
                                       placeholder="Paste the full English chapter text here..."/>
                            </group>
                        </page>
                        <page string="Urdu">
                            <group>
                                <field name="title_ur" string="Title (Urdu)"
                                       placeholder="e.g. خدا ہمارے ساتھ"/>
                                <field name="text_ur"  string="Text (Urdu)" widget="text"
                                       placeholder="Paste the full Urdu chapter text here..."/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>How it works:</strong>
                                When the app opens this chapter in Urdu mode it uses the
                                Urdu text entered here. If no Urdu text is provided, the app
                                falls back to the bundled JSON translation (if available) or
                                Google Translate.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onevoice_book_chapter" model="ir.actions.act_window">
        <field name="name">All Chapters</field>
        <field name="res_model">onevoice.book.chapter</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ─── Book list & form ───────────────────────────────── -->

    <record id="view_onevoice_book_list" model="ir.ui.view">
        <field name="name">onevoice.book.list</field>
        <field name="model">onevoice.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="sequence"      string="Order" widget="handle"/>
                <field name="name"          string="Title"/>
                <field name="book_code"     string="App Code"/>
                <field name="author"        string="Author"    optional="show"/>
                <field name="chapter_count" string="Chapters"/>
                <field name="is_published"  string="Published"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_book_form" model="ir.ui.view">
        <field name="name">onevoice.book.form</field>
        <field name="model">onevoice.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <group string="Book Details">
                            <field name="name"         string="Title"
                                   placeholder="e.g. Desire of Ages"/>
                            <field name="book_code"    string="App Code"
                                   placeholder="e.g. desire_of_ages  (lowercase, underscores)"/>
                            <field name="author"       string="Author"
                                   placeholder="e.g. Ellen G. White"/>
                            <field name="sequence"     string="Display Order"/>
                            <field name="is_published" string="Published"/>
                        </group>
                        <group string="Description">
                            <field name="description"  string="Description" widget="text"
                                   nolabel="1"
                                   placeholder="Short description shown in the app..."/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <strong>Important:</strong>
                        The <em>App Code</em> is how the app identifies this book.
                        Set it once and do not change it after publishing —
                        changing it will break the app's fallback-to-JSON logic.
                        Recommended codes: <code>desire_of_ages</code>,
                        <code>patriarchs_prophets</code>, <code>great_controversy</code>.
                    </div>
                    <notebook>
                        <page string="Chapters">
                            <field name="chapter_ids" widget="one2many_list"
                                   context="{'default_book_id': active_id}">
                                <list editable="bottom" default_order="chapter_number">
                                    <field name="chapter_number" string="Ch #"/>
                                    <field name="title_en"       string="English Title"/>
                                    <field name="title_ur"       string="Urdu Title"
                                           optional="show"/>
                                    <field name="is_published"   string="Published"/>
                                    <field name="notes"          string="Notes"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onevoice_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">onevoice.book</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_published': True}</field>
    </record>

</odoo>
