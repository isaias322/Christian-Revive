<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Allow public account creation (buyers sign up instantly) -->
        <function model="ir.config_parameter" name="set_param"
                  eval="('auth_signup.invitation_scope', 'b2c')"/>

        <!-- NOTE: the original standalone Marketplace project deleted
             website_sale's default "Shop" menu here, on the assumption
             this database sells only through /market. In THIS deployment
             the same website record is shared with Revive Lifestyle and
             Christian Revive, both of which need that "Shop" menu link -
             deleting it took down their live navigation the first time
             this installed. Left removed deliberately; see
             lifestyle_connector/data/restore_shop_menu.xml, which
             recreates the menu item after this module's install runs. -->

        <!-- Website menu entries -->
        <record id="menu_market" model="website.menu">
            <field name="name">Revive Marketplace</field>
            <field name="url">/market</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">15</field>
        </record>
        <record id="menu_sell" model="website.menu">
            <field name="name">Sell an Item</field>
            <field name="url">/market/sell</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">16</field>
        </record>
    </data>
</odoo>
