<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_reconciliation_batch_list" model="ir.ui.view">
        <field name="name">church.give.reconciliation.batch.list</field>
        <field name="model">church.give.reconciliation.batch</field>
        <field name="arch" type="xml">
            <list string="Reconciliation Batches">
                <field name="name"/>
                <field name="date"/>
                <field name="status"/>
                <field name="total_amount"/>
                <field name="prepared_by_id"/>
                <field name="approved_by_id"/>
            </list>
        </field>
    </record>

    <record id="view_reconciliation_batch_form" model="ir.ui.view">
        <field name="name">church.give.reconciliation.batch.form</field>
        <field name="model">church.give.reconciliation.batch</field>
        <field name="arch" type="xml">
            <form string="Reconciliation Batch">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="status != 'draft'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="status"/>
                            <field name="total_amount"/>
                        </group>
                        <group>
                            <field name="prepared_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="approved_at"/>
                        </group>
                    </group>
                    <field name="transaction_ids"/>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_reconciliation_batches" model="ir.actions.act_window">
        <field name="name">Reconciliation Batches</field>
        <field name="res_model">church.give.reconciliation.batch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
