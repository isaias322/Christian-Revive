<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_lifestyle" model="ir.ui.view">
        <field name="name">sale.order.form.lifestyle</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="before">
                <button name="action_mark_build_started" type="object"
                        string="Mark Build Started" class="btn-primary"
                        invisible="delivery_stage != 'order_placed' or state not in ('sale', 'done')"/>
                <button name="action_mark_packing" type="object"
                        string="Mark Build &amp; Packing" class="btn-secondary"
                        invisible="delivery_stage != 'processing'"/>
                <button name="action_notify_ready_for_pickup" type="object"
                        string="Ready for Pickup" class="btn-secondary"
                        invisible="fulfillment_type != 'pickup' or delivery_stage not in ('processing', 'packing')"/>
                <button name="action_notify_out_for_delivery" type="object"
                        string="Out for Delivery" class="btn-secondary"
                        invisible="fulfillment_type != 'delivery' or delivery_stage not in ('processing', 'packing')"/>
                <button name="action_mark_delivered" type="object"
                        string="Mark Delivered" class="btn-primary"
                        invisible="delivery_stage != 'out_for_delivery'"/>
                <button name="action_mark_picked_up" type="object"
                        string="Mark Picked Up" class="btn-primary"
                        invisible="delivery_stage != 'ready_for_pickup'"/>
                <button name="action_send_photo_to_customer" type="object"
                        string="Send Progress Update" class="btn-secondary" icon="fa-camera"
                        invisible="state not in ('sale', 'done') or delivery_stage in ('delivered', 'picked_up')"/>
                <button name="action_notify_assigned_vendor" type="object"
                        string="Notify Assigned Vendor" class="btn-secondary" icon="fa-bell"
                        invisible="not lifestyle_vendor_id"/>
                <button name="action_unlock_stage_correction" type="object"
                        string="Allow Stage Correction" class="btn-secondary" icon="fa-unlock"
                        invisible="lifestyle_stage_unlocked"/>
                <button name="action_lock_stage_correction" type="object"
                        string="Lock Stage Correction" class="btn-secondary" icon="fa-lock"
                        invisible="not lifestyle_stage_unlocked"/>
            </xpath>
            <!-- Anchor on product_template_id inside the <list>: it is the
                 visible Product column. The old anchor (first product_id
                 under order_line) matched the line's form sub-view, so the
                 color never appeared as a list column. -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="after">
                <field name="lifestyle_color" optional="show" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fulfillment_type"/>
                <field name="lifestyle_vendor_id" options="{'no_create_edit': True}"/>
                <field name="delivery_stage" readonly="1"/>
                <field name="lifestyle_progress_percent"/>
                <field name="lifestyle_stage_unlocked" readonly="1"/>
                <field name="lifestyle_coupon_code" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>



