<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Form view -->
    <record id="view_onevoice_event_form" model="ir.ui.view">
        <field name="name">onevoice.event.form</field>
        <field name="model">onevoice.event</field>
        <field name="arch" type="xml">
            <form string="OneVoice27 Event">
                <header>
                    <field name="is_active" widget="boolean_button"
                           options="{'terminology': 'active'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Hidden from App"
                            bg_color="text-bg-warning"
                            invisible="is_active"/>
                    <field name="image" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Event title…"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="category"/>
                            <field name="location"
                                   placeholder="City, venue, or online"/>
                            <field name="registration_link"
                                   placeholder="https://…"/>
                        </group>
                        <group string="Schedule">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"
                                   placeholder="Add full event details here…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_onevoice_event_list" model="ir.ui.view">
        <field name="name">onevoice.event.list</field>
        <field name="model">onevoice.event</field>
        <field name="arch" type="xml">
            <list string="OneVoice27 Events"
                  decoration-muted="not is_active">
                <field name="image" widget="image"
                       options="{'size': [38, 38]}"/>
                <field name="name"/>
                <field name="category"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="location"/>
                <field name="is_active" string="Active"/>
            </list>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="view_onevoice_event_kanban" model="ir.ui.view">
        <field name="name">onevoice.event.kanban</field>
        <field name="model">onevoice.event</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="category"/>
                <field name="date_start"/>
                <field name="location"/>
                <field name="is_active"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('onevoice.event', 'image', record.id.raw_value)"
                                     alt="Event"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <field name="category"/>
                                </div>
                                <ul>
                                    <li><field name="date_start"/></li>
                                    <li><field name="location"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_onevoice_event" model="ir.actions.act_window">
        <field name="name">OneVoice27 Events</field>
        <field name="res_model">onevoice.event</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'default_is_active': True}</field>
    </record>

</odoo>
