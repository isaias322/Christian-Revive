<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_lifestyle_pin" model="ir.ui.view">
        <field name="name">hr.employee.form.lifestyle.pin</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Vendor App PIN Login" invisible="staff_role != 'carpenter'">
                    <field name="app_pin_failed_attempts" readonly="1"/>
                    <field name="app_pin_locked_until" readonly="1"/>
                    <button name="action_unlock_app_pin" type="object"
                            string="Unlock App PIN" class="btn-secondary" icon="fa-unlock"
                            invisible="not app_pin_locked_until"
                            help="Resets failed PIN attempts so this vendor can log in to the app again right away."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
