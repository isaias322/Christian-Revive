<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every page goes through website.layout, so its <head> is a safe,
         universal place to load the brand fonts (kept out of the SCSS
         bundle - see lifestyle_web_theme.scss for why). -->
    <template id="lifestyle_web_fonts" inherit_id="website.layout" name="Revive Lifestyle Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&amp;family=Fraunces:wght@600&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <!-- Replaces the whole #wrap div rather than patching its current
         contents, since the homepage's body is onboarding-generated content
         stored in the database (not the module's own static template) -
         #wrap itself is the one anchor guaranteed to exist regardless of
         whatever placeholder content is currently inside it. -->
    <template id="lifestyle_homepage" inherit_id="website.homepage" name="Revive Lifestyle Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">
                <section class="py-5" style="background-color: #F7F5F0;">
                    <div class="container py-5 text-center">
                        <h1 class="display-4 mb-3">Furniture, fresh produce &amp; pantry essentials</h1>
                        <p class="lead text-muted mb-4">
                            Everything for your home, delivered or ready for pickup - with build progress
                            and delivery tracked every step of the way.
                        </p>
                        <a href="/shop" class="btn btn-primary btn-lg">Shop Now</a>
                    </div>
                </section>
                <section class="py-5">
                    <div class="container">
                        <div class="row g-4">
                            <div class="col-12 col-md-4">
                                <div class="lifestyle-card h-100 text-center">
                                    <h4 class="mb-2">Furniture &amp; Home</h4>
                                    <p class="text-muted mb-3">Handmade pieces, built to order and tracked from
                                        workshop to your door.</p>
                                    <a href="/shop" class="btn btn-outline-secondary">Browse Furniture</a>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="lifestyle-card h-100 text-center">
                                    <h4 class="mb-2">Fruits &amp; Vegetables</h4>
                                    <p class="text-muted mb-3">Fresh produce, picked and packed for delivery
                                        or in-store pickup.</p>
                                    <a href="/shop" class="btn btn-outline-secondary">Browse Produce</a>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="lifestyle-card h-100 text-center">
                                    <h4 class="mb-2">Healthy Pantry</h4>
                                    <p class="text-muted mb-3">Pantry staples and healthy essentials for
                                        everyday cooking.</p>
                                    <a href="/shop" class="btn btn-outline-secondary">Browse Pantry</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="py-5" style="background-color: #E3EADB;">
                    <div class="container text-center">
                        <h3 class="mb-3">Track every order, every step</h3>
                        <p class="text-muted mb-0">
                            From order placed to build started, packing, and delivery - follow your
                            furniture's progress and see workshop photos as they're sent, right from
                            your account.
                        </p>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- Anchored on div#introduction, a stable top-level child of
         sale.sale_order_portal_content that has existed across many Odoo
         versions - verified against the Odoo 18 source before writing this,
         to avoid an xpath-not-found error blocking the whole module install. -->
    <template id="portal_order_lifestyle_progress" inherit_id="sale.sale_order_portal_content"
              name="Revive Lifestyle Delivery Progress">
        <xpath expr="//div[@id='introduction']" position="after">
            <div t-if="sale_order.delivery_stage" class="lifestyle-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Furniture Progress</h5>
                    <span class="lifestyle-badge">
                        <t t-esc="sale_order.lifestyle_progress_percent"/>%
                    </span>
                </div>
                <div class="lifestyle-progress mb-3">
                    <div t-attf-style="width: #{sale_order.lifestyle_progress_percent}%;"/>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <t t-foreach="sale_order._lifestyle_timeline()" t-as="step">
                        <span t-attf-class="lifestyle-badge #{'' if step['done'] else 'opacity-50'}">
                            <t t-esc="step['label']"/>
                            <t t-if="step['current']"> (current)</t>
                        </span>
                    </t>
                </div>
            </div>
            <t t-set="lifestyle_media" t-value="sale_order._lifestyle_media_list()"/>
            <div t-if="lifestyle_media" class="lifestyle-card mb-4">
                <h5 class="mb-3">Latest Workshop Update</h5>
                <t t-set="latest" t-value="lifestyle_media[0]"/>
                <span t-if="latest['stage_label']" class="lifestyle-badge mb-2 d-inline-block">
                    <t t-esc="latest['stage_label']"/>
                </span>
                <div t-if="latest['url'] and not latest['mimetype'].startswith('video/')" class="mb-2">
                    <img t-att-src="latest['url']" class="img-fluid rounded" style="max-height: 320px; object-fit: cover;"/>
                </div>
                <div t-if="latest['url'] and latest['mimetype'].startswith('video/')" class="mb-2">
                    <video controls="controls" class="img-fluid rounded" style="max-height: 320px;">
                        <source t-att-src="latest['url']" t-att-type="latest['mimetype']"/>
                    </video>
                </div>
                <p t-if="latest['comment']" t-esc="latest['comment']" class="mb-0"/>
            </div>
        </xpath>
    </template>
</odoo>
