<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_church_member" model="res.groups">
            <field name="name">Church: Member</field>
        </record>
        <record id="group_church_cell_leader" model="res.groups">
            <field name="name">Church: Cell Leader</field>
            <field name="implied_ids" eval="[(4, ref('group_church_member'))]"/>
        </record>
        <record id="group_church_pastor" model="res.groups">
            <field name="name">Church: Pastor</field>
            <field name="implied_ids" eval="[(4, ref('group_church_cell_leader'))]"/>
        </record>
        <record id="group_church_admin" model="res.groups">
            <field name="name">Church: Admin</field>
            <field name="implied_ids" eval="[(4, ref('group_church_pastor'))]"/>
        </record>
    </data>
</odoo>
