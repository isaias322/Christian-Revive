<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_revive_homepage_section_list" model="ir.ui.view">
        <field name="name">lifestyle.homepage.section.list</field>
        <field name="model">lifestyle.homepage.section</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="section_key"/>
                <field name="title"/>
                <field name="background_style"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_revive_homepage_section_form" model="ir.ui.view">
        <field name="name">lifestyle.homepage.section.form</field>
        <field name="model">lifestyle.homepage.section</field>
        <field name="arch" type="xml">
            <form string="Homepage Section">
                <sheet>
                    <group>
                        <group string="Section Content">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="section_key"/>
                            <field name="name"/>
                            <field name="kicker"/>
                            <field name="title"/>
                            <field name="subtitle"/>
                        </group>
                        <group string="Media and Layout">
                            <field name="image" widget="image" class="oe_avatar"/>
                            <field name="layout"/>
                            <field name="show_items"/>
                            <field name="show_products" invisible="section_key != 'featured'"/>
                            <field name="show_status_badge" invisible="section_key != 'featured'"/>
                        </group>
                    </group>
                    <group string="Design" col="2">
                        <group>
                            <field name="background_style"/>
                            <field name="background_color" invisible="background_style != 'custom'"/>
                            <field name="background_color_2" invisible="background_style != 'custom'"/>
                            <field name="card_background_color"/>
                        </group>
                        <group>
                            <field name="text_color"/>
                            <field name="accent_color"/>
                        </group>
                    </group>
                    <group string="Button" col="2">
                        <field name="show_button"/>
                        <field name="button_label"/>
                        <field name="button_url"/>
                        <field name="button_icon"/>
                    </group>
                    <group string="Featured Product Settings" invisible="section_key != 'featured'" col="2">
                        <field name="product_limit"/>
                        <field name="empty_title"/>
                        <field name="empty_button_label"/>
                        <field name="empty_button_url"/>
                    </group>
                    <notebook>
                        <page string="Cards / Chips">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="active"/>
                                    <field name="item_style"/>
                                    <field name="icon"/>
                                    <field name="title"/>
                                    <field name="text"/>
                                    <field name="url"/>
                                    <field name="color"/>
                                    <field name="background_color"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_revive_homepage_section_item_list" model="ir.ui.view">
        <field name="name">lifestyle.homepage.section.item.list</field>
        <field name="model">lifestyle.homepage.section.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="section_id"/>
                <field name="item_style"/>
                <field name="icon"/>
                <field name="title"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_revive_homepage_section_item_form" model="ir.ui.view">
        <field name="name">lifestyle.homepage.section.item.form</field>
        <field name="model">lifestyle.homepage.section.item</field>
        <field name="arch" type="xml">
            <form string="Homepage Section Item">
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="section_id"/>
                            <field name="item_style"/>
                            <field name="icon"/>
                            <field name="title"/>
                            <field name="text"/>
                            <field name="url"/>
                        </group>
                        <group>
                            <field name="image" widget="image" class="oe_avatar"/>
                            <field name="color"/>
                            <field name="background_color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_revive_homepage_section" model="ir.actions.act_window">
        <field name="name">Homepage Sections</field>
        <field name="res_model">lifestyle.homepage.section</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_revive_homepage_section_item" model="ir.actions.act_window">
        <field name="name">Homepage Section Items</field>
        <field name="res_model">lifestyle.homepage.section.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_revive_homepage_section"
              name="Homepage Sections"
              parent="menu_revive_website_root"
              action="action_revive_homepage_section"
              sequence="20"/>

    <menuitem id="menu_revive_homepage_section_item"
              name="Homepage Section Items"
              parent="menu_revive_website_root"
              action="action_revive_homepage_section_item"
              sequence="30"/>
</odoo>