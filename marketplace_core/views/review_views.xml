<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_review_list" model="ir.ui.view">
        <field name="name">marketplace.review.list</field>
        <field name="model">marketplace.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="seller_id"/>
                <field name="reviewer_id"/>
                <field name="order_id"/>
                <field name="rating"/>
                <field name="comment"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_marketplace_review_form" model="ir.ui.view">
        <field name="name">marketplace.review.form</field>
        <field name="model">marketplace.review</field>
        <field name="arch" type="xml">
            <form string="Review">
                <header>
                    <button name="action_hide" type="object" string="Hide"
                            invisible="state != 'published'"
                            groups="marketplace_core.group_marketplace_moderator"/>
                    <button name="action_publish" type="object" string="Publish"
                            invisible="state != 'hidden'"
                            groups="marketplace_core.group_marketplace_moderator"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="seller_id"/>
                            <field name="reviewer_id"/>
                            <field name="order_id"/>
                        </group>
                        <group>
                            <field name="rating"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <group string="Comment">
                        <field name="comment" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_marketplace_reviews" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">marketplace.review</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
