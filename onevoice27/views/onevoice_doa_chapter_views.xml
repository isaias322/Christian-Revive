<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ─── Desire of Ages Chapters ───────────────────────── -->

    <record id="view_onevoice_doa_chapter_list" model="ir.ui.view">
        <field name="name">onevoice.doa.chapter.list</field>
        <field name="model">onevoice.doa.chapter</field>
        <field name="arch" type="xml">
            <list string="Desire of Ages Chapters" default_order="chapter_number">
                <field name="chapter_number" string="Ch #"        />
                <field name="title_en"       string="English Title"/>
                <field name="title_ur"       string="Urdu Title"   optional="show"/>
                <field name="is_published"   string="Published"    />
                <field name="notes"          string="Notes"        optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_doa_chapter_form" model="ir.ui.view">
        <field name="name">onevoice.doa.chapter.form</field>
        <field name="model">onevoice.doa.chapter</field>
        <field name="arch" type="xml">
            <form string="Desire of Ages Chapter">
                <sheet>
                    <group>
                        <group string="Chapter Info">
                            <field name="chapter_number" string="Chapter Number"/>
                            <field name="is_published"   string="Published"/>
                            <field name="notes"          string="Admin Notes"
                                   placeholder="Optional — e.g. 'reviewed 2026-05'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="English">
                            <group>
                                <field name="title_en" string="Title"
                                       placeholder="e.g. God With Us"/>
                                <field name="text_en"  string="Chapter Text"
                                       widget="text"
                                       placeholder="Paste the full English chapter text here..."/>
                            </group>
                        </page>
                        <page string="Urdu">
                            <group>
                                <field name="title_ur" string="Title (Urdu)"
                                       placeholder="e.g. خدا ہمارے ساتھ"/>
                                <field name="text_ur"  string="Chapter Text (Urdu)"
                                       widget="text"
                                       placeholder="Paste the full Urdu chapter text here..."/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>How it works:</strong>
                                When the app opens a chapter in Urdu mode it will use the
                                Urdu text entered here. If this chapter is not yet entered,
                                the app falls back to the bundled JSON translation.
                                Roman-word overrides and Urdu word overrides still apply on
                                top of whatever text is shown.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onevoice_doa_chapter" model="ir.actions.act_window">
        <field name="name">Desire of Ages Chapters</field>
        <field name="res_model">onevoice.doa.chapter</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_published': True}</field>
    </record>

</odoo>
