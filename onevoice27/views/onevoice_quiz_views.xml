<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ─── Quiz ──────────────────────────────────────────────── -->

    <record id="view_onevoice_quiz_list" model="ir.ui.view">
        <field name="name">onevoice.quiz.list</field>
        <field name="model">onevoice.quiz</field>
        <field name="arch" type="xml">
            <list string="Quizzes">
                <field name="name"/>
                <field name="question_count" string="Questions"/>
                <field name="attempt_count" string="Attempts"/>
                <field name="shuffle_questions"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_quiz_form" model="ir.ui.view">
        <field name="name">onevoice.quiz.form</field>
        <field name="model">onevoice.quiz</field>
        <field name="arch" type="xml">
            <form string="Quiz">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Quiz name…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_active"/>
                            <field name="shuffle_questions"/>
                            <field name="question_count" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description" placeholder="Optional description…"/>
                    <separator string="Questions"/>
                    <field name="question_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="question_type"/>
                            <field name="question_text" string="Question"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onevoice_quiz" model="ir.actions.act_window">
        <field name="name">Quizzes</field>
        <field name="res_model">onevoice.quiz</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ─── Quiz Question (standalone list + form for import) ── -->

    <record id="view_onevoice_quiz_question_list" model="ir.ui.view">
        <field name="name">onevoice.quiz.question.list</field>
        <field name="model">onevoice.quiz.question</field>
        <field name="arch" type="xml">
            <list string="Quiz Questions">
                <field name="quiz_id" string="Quiz"/>
                <field name="sequence" string="Seq"/>
                <field name="question_type" string="Type"/>
                <field name="question_text" string="Question"/>
            </list>
        </field>
    </record>

    <record id="action_onevoice_quiz_question" model="ir.actions.act_window">
        <field name="name">Quiz Questions</field>
        <field name="res_model">onevoice.quiz.question</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_onevoice_quiz_question_form" model="ir.ui.view">
        <field name="name">onevoice.quiz.question.form</field>
        <field name="model">onevoice.quiz.question</field>
        <field name="arch" type="xml">
            <form string="Quiz Question">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <group>
                        <group>
                            <field name="quiz_id"/>
                            <field name="question_type"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <separator string="Question Text"/>
                    <field name="question_text" placeholder="Enter your question…"/>
                    <separator string="Answer Options"/>
                    <field name="option_ids">
                        <list editable="bottom">
                            <field name="option_text" string="Option"/>
                            <field name="is_correct" string="Correct?"/>
                        </list>
                    </field>
                    <separator string="Explanation (shown to users after answering)"/>
                    <field name="explanation"
                           placeholder="Explain why the correct answer is right, add Scripture references, or give extra context…"
                           style="min-height:80px;"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── Quiz Option (standalone list for import) ──────────── -->

    <record id="view_onevoice_quiz_option_list" model="ir.ui.view">
        <field name="name">onevoice.quiz.option.list</field>
        <field name="model">onevoice.quiz.option</field>
        <field name="arch" type="xml">
            <list string="Quiz Options">
                <field name="question_id" string="Question"/>
                <field name="option_text" string="Option Text"/>
                <field name="is_correct" string="Correct?"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_quiz_option_form" model="ir.ui.view">
        <field name="name">onevoice.quiz.option.form</field>
        <field name="model">onevoice.quiz.option</field>
        <field name="arch" type="xml">
            <form string="Quiz Option">
                <sheet>
                    <group>
                        <field name="question_id"/>
                        <field name="option_text"/>
                        <field name="is_correct"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onevoice_quiz_option" model="ir.actions.act_window">
        <field name="name">Quiz Options</field>
        <field name="res_model">onevoice.quiz.option</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ─── Quiz Attempt (results view) ─────────────────────── -->

    <record id="view_onevoice_quiz_attempt_list" model="ir.ui.view">
        <field name="name">onevoice.quiz.attempt.list</field>
        <field name="model">onevoice.quiz.attempt</field>
        <field name="arch" type="xml">
            <list string="Quiz Results" create="0" delete="0">
                <field name="completed_at" string="Date"/>
                <field name="quiz_id"/>
                <field name="user_name" string="User"/>
                <field name="score" string="Score"/>
                <field name="total_questions" string="Total Qs"/>
                <field name="score_percent" string="Score %"/>
                <field name="passed" string="Passed?"/>
                <field name="retake_count" string="Retakes"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_quiz_attempt_graph" model="ir.ui.view">
        <field name="name">onevoice.quiz.attempt.graph</field>
        <field name="model">onevoice.quiz.attempt</field>
        <field name="arch" type="xml">
            <graph string="Quiz Results" type="bar">
                <field name="quiz_id" type="row"/>
                <field name="score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_onevoice_quiz_attempt_pivot" model="ir.ui.view">
        <field name="name">onevoice.quiz.attempt.pivot</field>
        <field name="model">onevoice.quiz.attempt</field>
        <field name="arch" type="xml">
            <pivot string="Quiz Results">
                <field name="quiz_id" type="row"/>
                <field name="score" type="measure"/>
                <field name="total_questions" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_onevoice_quiz_attempt" model="ir.actions.act_window">
        <field name="name">Quiz Results</field>
        <field name="res_model">onevoice.quiz.attempt</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

</odoo>
