<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_study_book_list" model="ir.ui.view">
        <field name="name">onevoice.study.book.list</field>
        <field name="model">onevoice.study.book</field>
        <field name="arch" type="xml">
            <list string="Study Books" default_order="sequence, name">
                <field name="sequence"     widget="handle"/>
                <field name="name"         string="Book Name"/>
                <field name="book_code"    string="Code"/>
                <field name="is_published" string="Published"/>
            </list>
        </field>
    </record>

    <record id="view_study_book_form" model="ir.ui.view">
        <field name="name">onevoice.study.book.form</field>
        <field name="model">onevoice.study.book</field>
        <field name="arch" type="xml">
            <form string="Study Book">
                <sheet>
                    <group>
                        <group string="Book Info">
                            <field name="name"         string="Book Name"/>
                            <field name="book_code"    string="Book Code"
                                   placeholder="e.g. desire_of_ages"/>
                            <field name="sequence"     string="Sequence"/>
                            <field name="is_published" string="Published"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chapters">
                            <field name="chapter_ids">
                                <list string="Chapters" editable="bottom"
                                      default_order="chapter_number">
                                    <field name="chapter_number" string="Ch #"/>
                                    <field name="title_en"       string="English Title"/>
                                    <field name="title_ur"       string="Urdu Title" optional="show"/>
                                    <field name="is_published"   string="Published"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_study_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">onevoice.study.book</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
