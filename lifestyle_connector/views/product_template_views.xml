<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_lifestyle" model="ir.ui.view">
        <field name="name">product.template.form.lifestyle</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Revive Lifestyle" name="revive_lifestyle_store">
                    <group>
                        <group string="Store Settings">
                            <field name="lifestyle_app_visible" string="Show in Revive Lifestyle App"/>
                            <field name="lifestyle_room_ids" string="Room for Website Shop" widget="many2many_tags"/>
                        </group>
                    </group>
                    <separator string="Color Images"/>
                    <button name="action_optimize_lifestyle_images" type="object"
                            string="Optimize Images for App" class="btn-secondary" icon="fa-compress"
                            help="Shrinks any oversized photo on this product so it loads quickly in the app."/>
                    <field name="color_image_ids" string="App Color Images">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="active"/>
                            <field name="color_name" string="Color / Finish"/>
                            <field name="image" string="App Image" widget="image" options="{'size': [96, 96]}"/>
                        </list>
                        <form string="App Color Image">
                            <group>
                                <group>
                                    <field name="active"/>
                                    <field name="sequence"/>
                                    <field name="color_name" string="Color / Finish"/>
                                </group>
                                <group>
                                    <field name="image" string="App Image" widget="image" options="{'size': [180, 180]}"/>
                                </group>
                            </group>
                        </form>
                    </field>
                    <group string="Legacy Color Images" col="2">
                        <group string="First Legacy Images">
                            <field name="lifestyle_color_image_1_color" string="Show Image 1 for Color"/>
                            <field name="lifestyle_color_image_1" string="Color Image 1" widget="image" class="oe_avatar" options="{'size': [120, 120]}"/>
                            <field name="lifestyle_color_image_2_color" string="Show Image 2 for Color"/>
                            <field name="lifestyle_color_image_2" string="Color Image 2" widget="image" class="oe_avatar" options="{'size': [120, 120]}"/>
                        </group>
                        <group string="More Legacy Images">
                            <field name="lifestyle_color_image_3_color" string="Show Image 3 for Color"/>
                            <field name="lifestyle_color_image_3" string="Color Image 3" widget="image" class="oe_avatar" options="{'size': [120, 120]}"/>
                            <field name="lifestyle_color_image_4_color" string="Show Image 4 for Color"/>
                            <field name="lifestyle_color_image_4" string="Color Image 4" widget="image" class="oe_avatar" options="{'size': [120, 120]}"/>
                        </group>
                    </group>
                    <separator string="Flash Deal"/>
                    <group string="Set Compare at Price higher than Price, then set an end time to feature this product in the app's Flash Deals carousel.">
                        <field name="lifestyle_deal_ends_at" string="Deal Ends At"/>
                    </group>
                    <separator string="Additional Store Images — Link to Another Product"/>
                    <group string="Optional cross-sell: leave blank to just show as a photo of this product.">
                        <field name="store_image_2_product_id" string="Image 2 Links To"/>
                        <field name="store_image_3_product_id" string="Image 3 Links To"/>
                        <field name="store_image_4_product_id" string="Image 4 Links To"/>
                    </group>
                    <separator string="Customer Reviews"/>
                    <field name="review_ids">
                        <list editable="bottom">
                            <field name="partner_id"/>
                            <field name="rating"/>
                            <field name="comment"/>
                            <field name="create_date" string="Submitted"/>
                        </list>
                    </field>
                </page>
                <page string="Christian Revive" name="christian_revive_store">
                    <group>
                        <group string="Store Settings">
                            <field name="is_store_product" string="Show in Christian Revive App"/>
                            <field name="lifestyle_room_ids" string="Room for Website Shop" widget="many2many_tags"/>
                        </group>
                    </group>
                    <separator string="Color Images (shared with Revive Lifestyle)"/>
                    <button name="action_optimize_lifestyle_images" type="object"
                            string="Optimize Images for App" class="btn-secondary" icon="fa-compress"
                            help="Shrinks any oversized photo on this product so it loads quickly in the app."/>
                    <field name="color_image_ids" string="App Color Images">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="active"/>
                            <field name="color_name" string="Color / Finish"/>
                            <field name="image" string="App Image" widget="image" options="{'size': [96, 96]}"/>
                        </list>
                        <form string="App Color Image">
                            <group>
                                <group>
                                    <field name="active"/>
                                    <field name="sequence"/>
                                    <field name="color_name" string="Color / Finish"/>
                                </group>
                                <group>
                                    <field name="image" string="App Image" widget="image" options="{'size': [180, 180]}"/>
                                </group>
                            </group>
                        </form>
                    </field>
                    <separator string="Flash Deal"/>
                    <group string="Set Compare at Price higher than Price, then set an end time to feature this product in the Christian Revive app's Flash Deals carousel.">
                        <field name="cr_deal_ends_at" string="Deal Ends At"/>
                    </group>
                    <separator string="Additional Store Images — Link to Another Product"/>
                    <group string="Optional cross-sell: leave blank to just show as a photo of this product.">
                        <field name="cr_store_image_2_product_id" string="Image 2 Links To"/>
                        <field name="cr_store_image_3_product_id" string="Image 3 Links To"/>
                        <field name="cr_store_image_4_product_id" string="Image 4 Links To"/>
                    </group>
                    <separator string="Customer Reviews (shared with Revive Lifestyle)"/>
                    <field name="review_ids" readonly="1">
                        <list>
                            <field name="partner_id"/>
                            <field name="rating"/>
                            <field name="comment"/>
                            <field name="create_date" string="Submitted"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>



