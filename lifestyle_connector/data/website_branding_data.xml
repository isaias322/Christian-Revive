<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Re-applies on every module upgrade (no noupdate="1"), so the
         website logo/favicon always match the bundled brand assets. -->
    <record id="website.default_website" model="website">
        <field name="logo" type="base64" file="lifestyle_connector/static/src/img/logo_wordmark.png"/>
        <field name="favicon" type="base64" file="lifestyle_connector/static/src/img/favicon.png"/>
    </record>
</odoo>
