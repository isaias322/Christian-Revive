<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Exchange rates — update via Settings > Technical > System Parameters -->
        <record id="param_give_rate_usd" model="ir.config_parameter">
            <field name="key">give.exchange_rate.usd</field>
            <field name="value">285.0</field>
        </record>
        <record id="param_give_rate_gbp" model="ir.config_parameter">
            <field name="key">give.exchange_rate.gbp</field>
            <field name="value">360.0</field>
        </record>
        <record id="param_give_rate_eur" model="ir.config_parameter">
            <field name="key">give.exchange_rate.eur</field>
            <field name="value">308.0</field>
        </record>

        <record id="seq_church_give_transaction" model="ir.sequence">
            <field name="name">Church Give Transaction</field>
            <field name="code">church.give.transaction</field>
            <field name="prefix">GIV-%(year)s%(month)s%(day)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="give_cat_tithe" model="church.give.category">
            <field name="name">Tithe</field>
            <field name="code">tithe</field>
            <field name="icon">🙏</field>
            <field name="sequence">1</field>
        </record>
        <record id="give_cat_offering" model="church.give.category">
            <field name="name">Offering</field>
            <field name="code">offering</field>
            <field name="icon">💝</field>
            <field name="sequence">2</field>
        </record>
        <record id="give_cat_missions" model="church.give.category">
            <field name="name">Missions</field>
            <field name="code">missions</field>
            <field name="icon">✈️</field>
            <field name="sequence">3</field>
        </record>
        <record id="give_cat_building" model="church.give.category">
            <field name="name">Building Fund</field>
            <field name="code">building</field>
            <field name="icon">🏛️</field>
            <field name="sequence">4</field>
        </record>
        <record id="give_cat_special" model="church.give.category">
            <field name="name">Special Gift</field>
            <field name="code">special</field>
            <field name="icon">⭐</field>
            <field name="sequence">5</field>
        </record>
    </data>
</odoo>