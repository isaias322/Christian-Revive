<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_brand_list" model="ir.ui.view">
        <field name="name">marketplace.brand.list</field>
        <field name="model">marketplace.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="is_luxury"/>
                <field name="listing_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_marketplace_brands" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">marketplace.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_marketplace_size_list" model="ir.ui.view">
        <field name="name">marketplace.size.list</field>
        <field name="model">marketplace.size</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_marketplace_sizes" model="ir.actions.act_window">
        <field name="name">Sizes</field>
        <field name="res_model">marketplace.size</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_marketplace_banned_keyword_list" model="ir.ui.view">
        <field name="name">marketplace.banned.keyword.list</field>
        <field name="model">marketplace.banned.keyword</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="reason"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_marketplace_banned_keywords" model="ir.actions.act_window">
        <field name="name">Banned Keywords</field>
        <field name="res_model">marketplace.banned.keyword</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
