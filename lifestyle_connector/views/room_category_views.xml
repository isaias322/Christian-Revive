<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lifestyle_room_category_list" model="ir.ui.view">
        <field name="name">lifestyle.room.category.list</field>
        <field name="model">lifestyle.room.category</field>
        <field name="arch" type="xml">
            <list string="Room Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Room Name"/>
            </list>
        </field>
    </record>

    <record id="view_lifestyle_room_category_form" model="ir.ui.view">
        <field name="name">lifestyle.room.category.form</field>
        <field name="model">lifestyle.room.category</field>
        <field name="arch" type="xml">
            <form string="Room Category">
                <sheet>
                    <group>
                        <field name="name" string="Room Name"/>
                        <field name="sequence" string="Order"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lifestyle_room_category" model="ir.actions.act_window">
        <field name="name">Room Categories</field>
        <field name="res_model">lifestyle.room.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_lifestyle_room_category"
              name="Room Categories"
              parent="sale.sale_menu_root"
              action="action_lifestyle_room_category"
              sequence="50"/>
</odoo>
