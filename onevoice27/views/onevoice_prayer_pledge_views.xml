<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_onevoice_prayer_pledge_list" model="ir.ui.view">
        <field name="name">onevoice.prayer.pledge.list</field>
        <field name="model">onevoice.prayer.pledge</field>
        <field name="arch" type="xml">
            <list string="Prayer Wall">
                <field name="pledge_name" string="Name"/>
                <field name="pledge_text" string="Prayer"/>
                <field name="pray_count" string="Prayed"/>
                <field name="posted_date"/>
                <field name="source_key"/>
            </list>
        </field>
    </record>

    <record id="view_onevoice_prayer_pledge_form" model="ir.ui.view">
        <field name="name">onevoice.prayer.pledge.form</field>
        <field name="model">onevoice.prayer.pledge</field>
        <field name="arch" type="xml">
            <form string="Prayer Wall Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="pledge_name" string="Name"/>
                            <field name="pray_count" string="Prayed Count"/>
                            <field name="posted_date"/>
                            <field name="source_key"/>
                            <field name="study_id"/>
                        </group>
                    </group>
                    <separator string="Prayer"/>
                    <field name="pledge_text" placeholder="Prayer text…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_onevoice_prayer_pledge" model="ir.actions.act_window">
        <field name="name">Prayer Wall</field>
        <field name="res_model">onevoice.prayer.pledge</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
