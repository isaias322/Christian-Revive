<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_payout_list" model="ir.ui.view">
        <field name="name">marketplace.seller.payout.list</field>
        <field name="model">marketplace.seller.payout</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="seller_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payout_method"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'requested'"
                       decoration-info="state == 'approved'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'rejected'"/>
                <field name="paid_date"/>
                <field name="payment_reference"/>
            </list>
        </field>
    </record>

    <record id="view_marketplace_payout_form" model="ir.ui.view">
        <field name="name">marketplace.seller.payout.form</field>
        <field name="model">marketplace.seller.payout</field>
        <field name="arch" type="xml">
            <form string="Payout Request">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'requested'" class="btn-primary"
                            groups="marketplace_core.group_marketplace_manager"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid"
                            invisible="state not in ('requested', 'approved')"
                            class="btn-success"
                            groups="marketplace_core.group_marketplace_manager"
                            confirm="Confirm the money has been transferred to the seller?"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('requested', 'approved')"
                            groups="marketplace_core.group_marketplace_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="seller_id" readonly="state != 'requested'"/>
                            <field name="amount" readonly="state != 'requested'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payout_method"/>
                        </group>
                        <group>
                            <field name="payment_reference"/>
                            <field name="paid_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_marketplace_payouts" model="ir.actions.act_window">
        <field name="name">Payout Requests</field>
        <field name="res_model">marketplace.seller.payout</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_marketplace_wallet_tx_list" model="ir.ui.view">
        <field name="name">marketplace.wallet.transaction.list</field>
        <field name="model">marketplace.wallet.transaction</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="seller_id"/>
                <field name="transaction_type"/>
                <field name="order_id"/>
                <field name="payout_id"/>
                <field name="signed_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_marketplace_wallet_transactions" model="ir.actions.act_window">
        <field name="name">Wallet Transactions</field>
        <field name="res_model">marketplace.wallet.transaction</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
