<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_journey_config_list" model="ir.ui.view">
        <field name="name">onevoice.journey.config.list</field>
        <field name="model">onevoice.journey.config</field>
        <field name="arch" type="xml">
            <list string="Prayer Journeys" default_order="sequence, journey_key">
                <field name="sequence"      widget="handle"/>
                <field name="journey_key"   string="Key"/>
                <field name="name"          string="Journey Name"/>
                <field name="available_from" string="Available From"/>
                <field name="is_active"     string="Active"/>
            </list>
        </field>
    </record>

    <record id="view_journey_config_form" model="ir.ui.view">
        <field name="name">onevoice.journey.config.form</field>
        <field name="model">onevoice.journey.config</field>
        <field name="arch" type="xml">
            <form string="Prayer Journey">
                <sheet>
                    <group>
                        <group string="Journey Info">
                            <field name="name"        string="Journey Name"/>
                            <field name="journey_key" string="Key"
                                   placeholder="e.g. 40_days or 365_days"/>
                            <field name="sequence"    string="Sequence"/>
                            <field name="is_active"   string="Active"/>
                        </group>
                        <group string="Lock / Unlock">
                            <field name="available_from" string="Available From"
                                   help="Leave empty to keep the journey locked. Set a date to unlock it starting that day."/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" string="Description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_journey_config" model="ir.actions.act_window">
        <field name="name">Prayer Journeys</field>
        <field name="res_model">onevoice.journey.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
