<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_onevoice_bible_study_form" model="ir.ui.view">
        <field name="name">onevoice.bible.study.form</field>
        <field name="model">onevoice.bible.study</field>
        <field name="arch" type="xml">
            <form string="OneVoice27 Perseverance">
                <header>
                    <button name="action_mark_certificate_issued" type="object" string="Certificate Issued"
                            class="btn-success"
                            invisible="not certificate_eligible or certificate_issued"/>
                    <field name="state" widget="statusbar" statusbar_visible="interested,in_progress,completed" invisible="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Certificate Ready" bg_color="text-bg-success"
                            invisible="not certificate_eligible or certificate_issued"/>
                    <widget name="web_ribbon" title="Certificate Issued" bg_color="text-bg-info"
                            invisible="not certificate_issued"/>
                    <group>
                        <group string="Contact Details">
                            <field name="contact_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="church_name"/>
                            <field name="location"/>
                        </group>
                        <group string="Meta">
                            <field name="partner_id"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Study Progress">
                        <group>
                            <field name="completed_session_count"/>
                            <field name="total_session_count"/>
                            <field name="certificate_eligible" readonly="1"/>
                        </group>
                        <group>
                            <field name="certificate_issued"/>
                            <field name="certificate_issued_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Engagement">
                        <group>
                            <field name="prayer_pledge_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="testimony_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="completed_session_ids" invisible="1"/>
                    <separator string="Prayer Pledges" invisible="not prayer_pledges_details"/>
                    <field name="prayer_pledges_details" readonly="1"
                           placeholder="No prayer pledges recorded yet."
                           invisible="not prayer_pledges_details"/>
                    <separator string="Testimonies" invisible="not testimonies_details"/>
                    <field name="testimonies_details" readonly="1"
                           placeholder="No testimonies recorded yet."
                           invisible="not testimonies_details"/>
                    <separator string="Notes"/>
                    <field name="notes" placeholder="Add follow-up notes here..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onevoice_bible_study_list" model="ir.ui.view">
        <field name="name">onevoice.bible.study.list</field>
        <field name="model">onevoice.bible.study</field>
        <field name="arch" type="xml">
            <list string="OneVoice27 Perseverance">
                <field name="contact_name"/>
                <field name="email"/>
                <field name="church_name"/>
                <field name="phone"/>
                <field name="location"/>
                <field name="completed_session_count"/>
                <field name="total_session_count"/>
                <field name="prayer_pledge_count"/>
                <field name="testimony_count"/>
                <field name="certificate_eligible"/>
                <field name="certificate_issued"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_onevoice_bible_study" model="ir.actions.act_window">
        <field name="name">OneVoice27 Perseverance</field>
        <field name="res_model">onevoice.bible.study</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
